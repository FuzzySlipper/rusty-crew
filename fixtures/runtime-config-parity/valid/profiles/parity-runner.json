{
  "profileId": "parity-runner",
  "displayName": "Parity Runner",
  "modelConfig": {
    "provider": "den-router",
    "modelName": "local-deterministic",
    "temperatureMilli": 100,
    "maxOutputTokens": 2048
  },
  "brain": {
    "module": "pi",
    "strategy": "default"
  },
  "runtime": {
    "defaultResourceLimits": {
      "maxDurationMs": 60000,
      "maxDelegationDepth": 4
    },
    "maxTokensPerTurn": 4096
  },
  "sessionDefaults": {
    "ownerId": "parity-owner",
    "maxHistoryMessages": 128
  },
  "mcpConfig": {
    "bindingId": "parity-runner-mcp",
    "endpointRef": "config://mcp/parity-runner",
    "serverNames": ["den", "memory"],
    "transport": "streamable_http",
    "toolProfile": "planner"
  },
  "backgroundReview": {
    "enabled": true,
    "reviewType": "combined",
    "schedule": "0 3 * * *"
  },
  "channelDefaults": {
    "wakePolicy": "subscription"
  },
  "contextPolicy": {
    "enabled": true,
    "strategyId": "rolling_summary_compaction",
    "autoCompactionEnabled": true,
    "compactAtPercent": 82,
    "targetPercentAfterCompaction": 58,
    "maxContextPercentForWake": 95,
    "debugVisibility": "status",
    "includeDebugEventsInModelContext": false,
    "strategyConfig": {
      "summaryShape": "brief"
    }
  },
  "skills": "all"
}
