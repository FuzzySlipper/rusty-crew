{
  "profilesDir": "__FIXTURE_ROOT__/profiles",
  "skillsDir": "__FIXTURE_ROOT__/skills",
  "denObservation": {
    "eventFilters": [
      { "eventKind": "session_created" },
      { "eventKind": "session_archived" },
      { "eventKind": "agent_message_routed", "visibility": "channel" },
      { "eventKind": "delegation_lifecycle_observed" },
      { "eventKind": "brain_wake_requested" },
      { "eventKind": "brain_actions_accepted" },
      { "eventKind": "completion_packet_delivered" }
    ]
  },
  "brains": [
    {
      "implementationId": "parity-runner-brain",
      "profileId": "parity-runner"
    }
  ],
  "sessions": [
    {
      "sessionId": "parity-runner-session",
      "agentId": "parity-runner",
      "profileId": "parity-runner",
      "kind": "full",
      "workspaceCwd": "__FIXTURE_ROOT__/work",
      "historyWindow": {
        "maxMessages": 12
      },
      "maxHistoryMessages": 24
    }
  ],
  "scheduledJobs": [
    {
      "id": "parity-runner-wake",
      "schedule": "*/10 * * * *",
      "shape": "session_wake",
      "targetSessionId": "parity-runner-session"
    },
    {
      "id": "parity-runner-maintenance",
      "schedule": "0 4 * * *",
      "shape": "host_job",
      "jobKind": "runtime.review.memory_skills",
      "script": "runtime-maintenance",
      "deliveryChannelId": "runtime-maintenance-output"
    }
  ],
  "channelBindings": [
    {
      "bindingId": "parity-runner-channel",
      "adapterId": "den-gateway",
      "provider": "den_conversation",
      "agentId": "parity-runner",
      "instanceId": "parity-runner-instance",
      "sessionId": "parity-runner-session",
      "profileId": "parity-runner",
      "externalChannelId": "40",
      "externalThreadId": "parity-thread",
      "externalUserId": "parity-user",
      "conversationProjectId": "rusty-crew",
      "conversationChannelId": 40,
      "providerSubscriptionId": "parity-subscription",
      "status": "disconnected"
    }
  ],
  "mcpBindings": [
    {
      "bindingId": "parity-audit-mcp",
      "adapterId": "mcp-ts-main",
      "agentId": "parity-runner",
      "instanceId": "parity-runner-instance",
      "sessionId": "parity-runner-session",
      "profileId": "parity-runner",
      "serverNames": ["den"],
      "endpointRef": "http://127.0.0.1:5199/mcp?tool_profile=audit",
      "transport": "streamable_http",
      "toolProfileKey": "audit",
      "status": "active"
    }
  ]
}
