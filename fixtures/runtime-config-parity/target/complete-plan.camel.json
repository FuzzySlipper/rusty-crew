{
  "accepted": true,
  "sourceRevision": "fixture-runtime-graph-v1",
  "runtimeConfig": {
    "profilesDir": "__FIXTURE_ROOT__/profiles",
    "skillsDir": "__FIXTURE_ROOT__/skills",
    "storage": {
      "backend": "sqlite",
      "implementationStatus": "active",
      "sqlite": {
        "path": "runtime.sqlite3",
        "effectivePath": "__FIXTURE_ROOT__/engine/runtime.sqlite3",
        "wal": true,
        "busyTimeoutMs": 5000
      },
      "postgres": {
        "databaseUrlEnv": "RUSTY_CREW_POSTGRES_URL",
        "schema": "rusty_crew",
        "bootMode": "active",
        "maxConnections": 16,
        "statementTimeoutMs": 30000
      }
    },
    "wakeTimeout": {
      "mode": "default",
      "defaultMs": 120000
    },
    "brains": [
      {
        "implementationId": "parity-runner-brain",
        "profileId": "parity-runner"
      }
    ],
    "sessions": [
      {
        "sessionId": "parity-runner-session",
        "agentId": "parity-runner",
        "profileId": "parity-runner",
        "kind": "full",
        "resourceLimits": {
          "workdir": "__FIXTURE_ROOT__/work",
          "maxDurationMs": 60000,
          "maxDelegationDepth": 4
        },
        "ownerId": "parity-owner",
        "maxHistoryMessages": 128,
        "turnTimeoutMs": 45000,
        "effectiveWakeTimeoutMs": 45000,
        "wakeTimeoutSource": "session_default",
        "localToolProfileId": "full-agent",
        "contextPolicyProfileId": "parity-runner",
        "sessionMemoryPromptProfileId": "parity-runner"
      }
    ],
    "scheduledJobs": [
      {
        "id": "background-review-parity-runner",
        "schedule": "0 3 * * *",
        "shape": "host_job",
        "jobKind": "runtime.review.memory_skills",
        "payload": {
          "profileId": "parity-runner",
          "reviewType": "combined"
        }
      },
      {
        "id": "parity-runner-wake",
        "schedule": "*/10 * * * *",
        "shape": "session_wake",
        "targetSessionId": "parity-runner-session"
      }
    ],
    "channelBindings": [
      {
        "bindingId": "parity-runner-channel",
        "adapterId": "den-gateway",
        "provider": "den_conversation",
        "agentId": "parity-runner",
        "sessionId": "parity-runner-session",
        "profileId": "parity-runner",
        "externalChannelId": "40",
        "status": "active"
      }
    ],
    "mcpBindings": [
      {
        "bindingId": "parity-runner-mcp",
        "adapterId": "mcp-ts-main",
        "agentId": "parity-runner",
        "sessionId": "parity-runner-session",
        "profileId": "parity-runner",
        "serverNames": [
          "den",
          "memory"
        ],
        "endpointRef": "config://mcp/parity-runner",
        "transport": "streamable_http",
        "toolProfileKey": "planner",
        "status": "active"
      }
    ]
  },
  "derived": [
    {
      "kind": "scheduled_job",
      "id": "background-review-parity-runner",
      "source": "profiles[parity-runner].backgroundReview"
    },
    {
      "kind": "mcp_binding",
      "id": "parity-runner-mcp",
      "source": "profiles[parity-runner].mcpConfig"
    }
  ],
  "defaultsApplied": [
    {
      "path": "brains[parity-runner].implementationId",
      "source": "canonical_profile_default"
    },
    {
      "path": "sessions[parity-runner-session].kind",
      "source": "service_default"
    },
    {
      "path": "sessions[parity-runner-session].resourceLimits.workdir",
      "source": "host_default_workdir"
    },
    {
      "path": "sessions[parity-runner-session].ownerId",
      "source": "profile_session_default"
    }
  ],
  "diagnostics": []
}
