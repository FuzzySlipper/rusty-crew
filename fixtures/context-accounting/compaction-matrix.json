{
  "schemaVersion": 1,
  "description": "Executable deterministic coverage catalog for provider projection, compaction policy, persistence, stream ordering, and bridge field ratchets.",
  "cases": [
    {
      "id": "chat-tool-output-image-continuation-retry",
      "class": "provider_projection",
      "sourceQuality": "provider/exact",
      "fixture": {
        "kind": "snapshot",
        "path": "chat-completions-provider.json",
        "providerProtocol": "chat_completions",
        "requiredSegments": ["tool_schemas", "reasoning"]
      },
      "testRefs": [
        "crates/brains/chat-completions/src/lib.rs::context_accounting_snapshot_reports_provider_usage_and_request_segments",
        "crates/brains/chat-completions/src/lib.rs::opted_image_is_serialized_once_and_redacted_from_debug_samples"
      ]
    },
    {
      "id": "responses-tool-output-image-continuation-retry",
      "class": "provider_projection",
      "sourceQuality": "provider/exact",
      "fixture": {
        "kind": "snapshot",
