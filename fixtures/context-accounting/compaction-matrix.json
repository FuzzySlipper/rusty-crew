        "crates/brains/openai-responses/src/lib.rs::responses_context_accounting_separates_current_request_from_logical_wake",
        "crates/brains/openai-responses/src/lib.rs::provider_state_replays_typed_reasoning_function_call_and_output_items"
      ]
    },
    {
      "id": "threshold-admitted",
      "class": "admission_policy",
      "sourceQuality": "provider/exact",
      "fixture": {
        "kind": "decision",
        "policy": {
          "enabled": true,
          "autoCompactionEnabled": true,
          "contextWindowTokens": 1000,
          "compactAtPercent": 80,
          "targetPercentAfterCompaction": 50
        },
        "providerInputTokens": 500,
        "serializedModelContextBytes": 32,
        "expected": "below_threshold",
        "expectedSource": "provider"
      },
      "testRefs": [
        "crates/brains/brain-runtime/src/context_compaction.rs::provider_usage_wins_over_estimate"
      ]
    },
    {
      "id": "threshold-near-threshold",
      "class": "admission_policy",
      "sourceQuality": "serialized_estimate/approximate",
      "fixture": {
        "kind": "decision",
        "policy": {
          "enabled": true,
          "autoCompactionEnabled": true,
          "contextWindowTokens": 1000,
          "compactAtPercent": 80,
          "targetPercentAfterCompaction": 50
