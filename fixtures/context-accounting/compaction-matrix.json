        "providerProtocol": "responses",
        "requiredSegments": ["replay_items", "reasoning"]
      },
      "testRefs": [
        "crates/brains/openai-responses/src/lib.rs::context_accounting_snapshot_reports_responses_chain_and_provider_usage",
