      "testRefs": [
        "crates/core/core-persistence/src/sqlite_integration_tests.rs::context_compaction_artifacts_preserve_raw_message_history",
        "crates/core/core-persistence/src/postgres_backend.rs::postgres_context_compaction_artifact_persists_and_reloads"
      ],
      "productionProbes": [
        {
          "package": "rusty-crew-core-persistence",
          "filter": "context_compaction_artifacts_preserve_raw_message_history"
        }
      ]
    },
