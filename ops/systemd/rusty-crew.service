[Unit]
Description=Rusty Crew local agent runtime
Documentation=file:/home/dev/rusty-crew/docs/local-service-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
SyslogIdentifier=rusty-crew-live
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000
WorkingDirectory=/home/dev/rusty-crew
EnvironmentFile=/home/system/database/rusty-crew-postgres.env
EnvironmentFile=/home/system/rusty-crew/config/service.env
EnvironmentFile=-/home/system/rusty-crew/config/adapter-secrets.env
ExecStartPre=/usr/bin/env npm run service:preflight
ExecStart=/usr/bin/env npm run service:start
Restart=on-failure
RestartSec=5s
WatchdogSec=45s
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=default.target
