[Unit]
Description=Rusty Crew debug/test runtime
Documentation=file:/home/dev/rusty-crew/docs/local-service-runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WorkingDirectory=/home/dev/rusty-crew
EnvironmentFile=/home/system/rusty-crew-debug/config/service.env
EnvironmentFile=-/home/system/rusty-crew-debug/config/adapter-secrets.env
ExecStartPre=/usr/bin/env npm run service:preflight
ExecStart=/usr/bin/env npm run service:start
Restart=on-failure
RestartSec=5s
WatchdogSec=45s
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=default.target
